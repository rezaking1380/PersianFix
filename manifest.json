{
  "manifest_version": 3,
  "name": "PersianFix",
  "version": "2.0.0",
  "author": "Reza ngr",
  "homepage_url": "https://github.com/rezaking1380",
  "default_locale": "fa",
  "description": "بهبود تایپوگرافی فارسی در صفحات وب با فونت وزیرمتن و پشتیبانی از دارک مود",
  "permissions": [
    "storage",
    "contextMenus"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "exclude_matches": [
        "https://chrome.google.com/webstore/*",
        "https://chromewebstore.google.com/*",
        "https://microsoftedge.microsoft.com/addons/*"
      ],
      "css": [
        "content.css"
      ],
      "js": [
        "lib/detect.js",
        "lib/textfix.js",
        "content.js",
        "editor.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "match_origin_as_fallback": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "fonts/Vazirmatn-Regular.woff2",
        "fonts/Vazirmatn-Medium.woff2",
        "fonts/Vazirmatn-Bold.woff2"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "PersianFix - اصلاح تایپوگرافی فارسی",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "convert-field": {
      "description": "Convert typed-in-wrong-layout text",
      "suggested_key": {
        "default": "Ctrl+Shift+Z"
      }
    },
    "fix-field": {
      "description": "Persian proofreading",
      "suggested_key": {
        "default": "Ctrl+Shift+P"
      }
    },
    "open-editor": {
      "description": "Open full text editor",
      "suggested_key": {
        "default": "Ctrl+Shift+E"
      }
    }
  },
  "minimum_chrome_version": "99"
}